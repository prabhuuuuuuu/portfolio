# ---------------------------------------------------------------------------
# Contact form (Gmail SMTP)
# ---------------------------------------------------------------------------
CONTACT_EMAIL_USER=pranavprashantshewale@gmail.com
# Gmail App Password (16 chars). Generate at https://myaccount.google.com/apppasswords
CONTACT_EMAIL_PASS=xxxx xxxx xxxx xxxx

# Optional overrides. Defaults are Gmail SMTP on port 465.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# SMTP_FROM="Portfolio Contact <pranavprashantshewale@gmail.com>"

# ---------------------------------------------------------------------------
# Blog admin
# ---------------------------------------------------------------------------
# Do not commit real values. Set these in .env.local and in Vercel.
ADMIN_USERNAME=prnvprshnt
ADMIN_PASSWORD=change-me
# Random string, at least 16 characters. Example generator:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_SESSION_SECRET=replace-with-a-long-random-secret

# ---------------------------------------------------------------------------
# Blog storage
# ---------------------------------------------------------------------------
# Local development writes to content/blog and public/blog on this machine
# (mode selected automatically when VERCEL is not set).
#
# Vercel has a read-only filesystem, so the deployed admin publishes through
# the GitHub Contents API. Create a fine-grained token scoped to this repo with
# "Contents: Read and write" permission.
GITHUB_TOKEN=
GITHUB_OWNER=prabhuuuuuuu
GITHUB_REPO=portfolio
GITHUB_BRANCH=main

# Optional: force a storage mode in any environment ("github" or "local").
# BLOG_STORAGE=github

# ---------------------------------------------------------------------------
# Public site URL
# ---------------------------------------------------------------------------
# Used for canonical URLs, Open Graph, sitemap, robots, and the RSS feed.
# On Vercel this falls back to the production deployment URL if unset.
# NEXT_PUBLIC_SITE_URL=https://your-domain.com
